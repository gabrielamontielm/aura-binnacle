{
  "entities": {
    "ArtItem": {
      "title": "Art Item",
      "description": "An artwork saved to the user's knowledge base",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "image": { "type": "string" },
        "details": {
          "type": "object",
          "properties": {
            "title": { "type": "string" },
            "artist": { "type": "string" },
            "year": { "type": "string" },
            "movement": { "type": "string" },
            "medium": { "type": "string" },
            "museum": { "type": "string" },
            "location": { "type": "string" },
            "type": { "type": "string" },
            "description": { "type": "string" },
            "historicalContext": { "type": "string" }
          },
          "required": ["title", "artist", "year", "movement", "medium", "type", "description", "historicalContext"]
        },
        "timestamp": { "type": "number" },
        "userId": { "type": "string" }
      },
      "required": ["id", "image", "details", "timestamp", "userId"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "Basic user information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "lastLogin": { "type": "number" },
        "isGalleryPublic": { "type": "boolean" },
        "level": { "type": "number" },
        "totalXP": { "type": "number" },
        "scansByMovement": { "type": "object" },
        "badges": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["uid", "email", "isGalleryPublic"]
    },
    "MuseumStamp": {
      "title": "Museum Passport Stamp",
      "description": "A digital stamp for a museum check-in",
      "type": "object",
      "properties": {
        "museumId": { "type": "string" },
        "museumName": { "type": "string" },
        "timestamp": { "type": "number" },
        "location": { "type": "object", "properties": { "lat": { "type": "number" }, "lng": { "type": "number" } } }
      },
      "required": ["museumId", "museumName", "timestamp"]
    },
    "QuizHistory": {
      "title": "Daily Quiz Item",
      "description": "Record of a daily art quiz attempt",
      "type": "object",
      "properties": {
        "date": { "type": "string" },
        "artworkId": { "type": "string" },
        "isCorrect": { "type": "boolean" },
        "xpEarned": { "type": "number" }
      },
      "required": ["date", "artworkId", "isCorrect"]
    },
    "DailyQuizQuestion": {
      "title": "Daily Quiz Question",
      "description": "A single question generated by AI or from user data",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "artworkTitle": { "type": "string" },
        "imageUrl": { "type": "string" },
        "type": { "type": "string" },
        "correctAnswer": { "type": "string" },
        "options": { "type": "array", "items": { "type": "string" } },
        "hint": { "type": "string" },
        "isAiGenerated": { "type": "boolean" }
      },
      "required": ["artworkTitle", "imageUrl", "type", "correctAnswer", "options", "hint", "isAiGenerated"]
    },
    "DailyQuizSession": {
      "title": "Daily Quiz Session",
      "description": "Set of questions for a specific day",
      "type": "object",
      "properties": {
        "date": { "type": "string" },
        "questions": { "type": "array", "items": { "$ref": "DailyQuizQuestion" } }
      },
      "required": ["date", "questions"]
    },
    "EntityMetadata": {
      "title": "Artwork Entity Metadata",
      "description": "Cached data for artists or movements",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "yearsOrPeriod": { "type": "string" },
        "originOrRegion": { "type": "string" },
        "significance": { "type": "string" },
        "detailedDescription": { "type": "string" },
        "keyCharacteristics": { "type": "array", "items": { "type": "string" } },
        "historicalImpact": { "type": "string" },
        "curatorialSummary": { "type": "string" },
        "famousWorks": { 
          "type": "array", 
          "items": { 
            "type": "object",
            "properties": {
              "title": { "type": "string" },
              "year": { "type": "string" },
              "museum": { "type": "string" },
              "location": { "type": "string" },
              "imageUrl": { "type": "string" }
            }
          }
        }
      },
      "required": ["name", "type", "yearsOrPeriod", "originOrRegion", "significance", "detailedDescription", "keyCharacteristics", "historicalImpact", "curatorialSummary", "famousWorks"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document"
    },
    "users/{userId}/items/{itemId}": {
      "schema": "ArtItem",
      "description": "The user's personal collection of artworks"
    },
    "users/{userId}/bucketlist/{favoriteId}": {
      "schema": "ArtItem",
      "description": "The user's bucket list artworks"
    },
    "users/{userId}/passport/{stampId}": {
      "schema": "MuseumStamp",
      "description": "The user's museum check-in stamps"
    },
    "users/{userId}/quiz_history/{quizId}": {
      "schema": "QuizHistory",
      "description": "The user's daily quiz records"
    },
    "public_items/{userId}/items/{itemId}": {
      "schema": "ArtItem",
      "description": "Shared artworks"
    },
    "metadata_artists/{artistId}": {
      "schema": "EntityMetadata",
      "description": "Cached data about artists"
    },
    "metadata_movements/{movementId}": {
      "schema": "EntityMetadata",
      "description": "Cached data about movements"
    },
    "daily_quizzes/{date}": {
      "schema": "DailyQuizSession",
      "description": "Masterpiece questions for the day"
    }
  }
}
