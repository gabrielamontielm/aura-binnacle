rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitive Definitions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Blueprints
    function isValidUserProfile(data) {
      return (!('uid' in data) || data.uid == request.auth.uid)
        && (!('email' in data) || (data.email is string && data.email.size() <= 256))
        && (!('displayName' in data) || data.displayName == null || (data.displayName is string && data.displayName.size() <= 128))
        && (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 1024))
        && (!('lastLogin' in data) || data.lastLogin is number)
        && (!('isGalleryPublic' in data) || data.isGalleryPublic is bool)
        && (!('isBucketListPublic' in data) || data.isBucketListPublic is bool)
        && (!('level' in data) || data.level is number)
        && (!('totalXP' in data) || data.totalXP is number);
    }

    function isValidArtDetails(details) {
      return (!('title' in details) || (details.title is string && details.title.size() <= 256))
        && (!('artist' in details) || (details.artist is string && details.artist.size() <= 256))
        && (!('year' in details) || details.year == null || details.year is string || details.year is number)
        && (!('description' in details) || details.description == null || (details.description is string && details.description.size() <= 10000))
        && (!('movement' in details) || details.movement == null || (details.movement is string && details.movement.size() <= 128))
        && (!('type' in details) || details.type == null || (details.type is string && details.type.size() <= 128))
        && (!('image' in details) || details.image == null || (details.image is string && details.image.size() <= 2048));
    }

    function isValidArtItem(data, itemId) {
      return (!('id' in data) || data.id == itemId)
        && (!('userId' in data) || (data.userId is string && data.userId.size() <= 128))
        && (!('details' in data) || (data.details is map && isValidArtDetails(data.details)))
        && (!('image' in data) || (data.image is string && data.image.size() <= 2048))
        && (!('timestamp' in data) || data.timestamp is number);
    }

    // Collection: Users
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());

      // Collection: Saved Items
      match /items/{itemId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(itemId);
        allow create: if isOwner(userId) && isValidId(itemId) && isValidArtItem(incoming(), itemId);
        allow update: if isOwner(userId) && isValidId(itemId) && isValidArtItem(incoming(), itemId);
        allow delete: if isOwner(userId) && isValidId(itemId);
      }

      // Collection: Bucket List
      match /bucketlist/{favoriteId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(favoriteId);
        allow create: if isOwner(userId) && isValidId(favoriteId) && isValidArtItem(incoming(), favoriteId);
        allow update: if isOwner(userId) && isValidId(favoriteId) && isValidArtItem(incoming(), favoriteId);
        allow delete: if isOwner(userId) && isValidId(favoriteId);
      }

      // Collection: Passport
      match /passport/{stampId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(stampId);
        allow create: if isOwner(userId) && isValidId(stampId);
      }

      // Collection: Quiz History
      match /quiz_history/{quizId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(quizId);
        allow create: if isOwner(userId) && isValidId(quizId);
      }
    }

    // Public Profiles - Anyone can read, only owner can write
    match /public_profiles/{userId} {
      allow get: if isValidId(userId);
      allow list: if false; // Prevention of user scraping
      allow create, update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow delete: if isOwner(userId) && isValidId(userId);
    }

    // Public items - Anyone can read their own or public ones
    match /public_items/{userId}/items/{itemId} {
      allow list: if isValidId(userId);
      allow get: if isValidId(userId) && isValidId(itemId);
      allow create, update: if isOwner(userId) && isValidId(userId) && isValidId(itemId) && isValidArtItem(incoming(), itemId);
      allow delete: if isOwner(userId) && isValidId(userId) && isValidId(itemId);
    }

    match /public_bucketlist/{userId}/items/{itemId} {
      allow list: if isValidId(userId);
      allow get: if isValidId(userId) && isValidId(itemId);
      allow create, update: if isOwner(userId) && isValidId(userId) && isValidId(itemId) && isValidArtItem(incoming(), itemId);
      allow delete: if isOwner(userId) && isValidId(userId) && isValidId(itemId);
    }

    match /public_passports/{userId}/stamps/{stampId} {
      allow list: if isValidId(userId);
      allow get: if isValidId(userId) && isValidId(stampId);
      allow create, update: if isOwner(userId) && isValidId(userId) && isValidId(stampId);
      allow delete: if isOwner(userId) && isValidId(userId) && isValidId(stampId);
    }

    // Metadata Cache - AI generated or user cached
    // In this app, users can cache artist info they scan
    match /metadata_artists/{artistId} {
      allow read: if isValidId(artistId);
      allow write: if isSignedIn() && isValidId(artistId);
    }
    match /metadata_movements/{movementId} {
      allow read: if isValidId(movementId);
      allow write: if isSignedIn() && isValidId(movementId);
    }
    match /metadata_museums/{museumId} {
      allow read: if isValidId(museumId);
      allow write: if isSignedIn() && isValidId(museumId);
    }

    match /daily_quizzes/{date} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /test/connection {
      allow read: if true;
    }
  }
}
