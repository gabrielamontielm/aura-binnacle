rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitive Definitions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isGalleryOwner() {
      // In this app, any signed-in user is a gallery owner
      return isSignedIn();
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Blueprints
    function isValidUserProfile(data) {
      return (!('uid' in data) || data.uid == request.auth.uid)
        && (!('email' in data) || (data.email is string && data.email.size() <= 256))
        && (!('displayName' in data) || data.displayName == null || data.displayName is string)
        && (!('photoURL' in data) || data.photoURL == null || data.photoURL is string)
        && (!('lastLogin' in data) || data.lastLogin is number)
        && (!('isGalleryPublic' in data) || data.isGalleryPublic is bool)
        && (!('isBucketListPublic' in data) || data.isBucketListPublic is bool)
        && (!('level' in data) || data.level is number)
        && (!('totalXP' in data) || data.totalXP is number);
    }

    function isValidArtDetails(details) {
      return (!('title' in details) || details.title is string)
        && (!('artist' in details) || details.artist is string)
        && (!('year' in details) || (details.year == null || details.year is string || details.year is number))
        && (!('description' in details) || (details.description == null || details.description is string))
        && (!('historicalContext' in details) || (details.historicalContext == null || details.historicalContext is string))
        && (!('museum' in details) || (details.museum == null || details.museum is string))
        && (!('location' in details) || (details.location == null || details.location is string))
        && (!('movement' in details) || (details.movement == null || details.movement is string))
        && (!('type' in details) || (details.type == null || details.type is string))
        && (!('dimensions' in details) || (details.dimensions == null || details.dimensions is string))
        && (!('medium' in details) || (details.medium == null || details.medium is string))
        && (!('funFact' in details) || (details.funFact == null || details.funFact is string))
        && (!('significance' in details) || (details.significance == null || details.significance is string))
        && (!('audioGuide' in details) || (details.audioGuide == null || details.audioGuide is string))
        && (!('entities' in details) || (details.entities == null || details.entities is list));
    }

    function isValidArtItem(data, itemId) {
      return (!('id' in data) || data.id == itemId)
        && (!('userId' in data) || data.userId is string)
        && (!('details' in data) || (data.details is map && isValidArtDetails(data.details)))
        && (!('image' in data) || data.image is string);
    }

    // Collection: Users
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());

      // Collection: Saved Items
      match /items/{itemId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(itemId);
        allow create: if isOwner(userId) && isValidId(itemId) && isValidArtItem(incoming(), itemId);
        allow update: if isOwner(userId) && isValidId(itemId) && isValidArtItem(incoming(), itemId);
        allow delete: if isOwner(userId) && isValidId(itemId);
      }

      // Collection: Bucket List
      match /bucketlist/{favoriteId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(favoriteId);
        allow create: if isOwner(userId) && isValidId(favoriteId) && isValidArtItem(incoming(), favoriteId);
        allow update: if isOwner(userId) && isValidId(favoriteId) && isValidArtItem(incoming(), favoriteId);
        allow delete: if isOwner(userId) && isValidId(favoriteId);
      }

      // Collection: Passport
      match /passport/{stampId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(stampId);
        allow create: if isOwner(userId) && isValidId(stampId);
      }

      // Collection: Quiz History
      match /quiz_history/{quizId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(quizId);
        allow create: if isOwner(userId) && isValidId(quizId);
      }
    }

    match /public_profiles/{userId} {
      allow get: if true;
      allow write: if isOwner(userId);
    }

    match /public_items/{userId}/items/{itemId} {
      allow list: if true;
      allow get: if true;
      allow create, update: if isOwner(userId) && isValidId(itemId) && isValidArtItem(incoming(), itemId);
      allow delete: if isOwner(userId) && isValidId(itemId);
    }

    match /public_bucketlist/{userId}/items/{itemId} {
      allow list: if true;
      allow get: if true;
      allow create, update: if isOwner(userId) && isValidId(itemId) && isValidArtItem(incoming(), itemId);
      allow delete: if isOwner(userId) && isValidId(itemId);
    }

    // Collections: Metadata Cache (Entities)
    match /metadata_artists/{artistId} {
      allow read: if true;
      allow write: if isGalleryOwner();
    }
    match /metadata_movements/{movementId} {
      allow read: if true;
      allow write: if isGalleryOwner();
    }
    match /metadata_museums/{museumId} {
      allow read: if true;
      allow write: if isGalleryOwner();
    }
    match /metadata_types/{typeId} {
      allow read: if true;
      allow write: if isGalleryOwner();
    }
    match /metadata_locations/{locationId} {
      allow read: if true;
      allow write: if isGalleryOwner();
    }

    match /daily_quizzes/{date} {
      allow read: if true;
      allow write: if isGalleryOwner();
    }

    match /test/connection {
      allow read: if true;
    }
  }
}
