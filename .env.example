# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# VITE_FIREBASE_API_KEY: Public Firebase API Key.
# Used on the client side to initialize Firebase.
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"

# GOOGLE_PHOTOS_CLIENT_ID: Your Google Cloud project Client ID
# Required for Google Photos OAuth flow.
GOOGLE_PHOTOS_CLIENT_ID="YOUR_GOOGLE_PHOTOS_CLIENT_ID"

# GOOGLE_PHOTOS_CLIENT_SECRET: Your Google Cloud project Client Secret
# Required for Google Photos OAuth flow.
GOOGLE_PHOTOS_CLIENT_SECRET="YOUR_GOOGLE_PHOTOS_CLIENT_SECRET"

# SESSION_SECRET: Secret for Express session management
# Required for securing OAuth sessions.
SESSION_SECRET="YOUR_SESSION_SECRET"
